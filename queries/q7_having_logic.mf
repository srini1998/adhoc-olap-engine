# HAVING with or/not and arithmetic: customer-product pairs whose 2019 total is more
# than 1.2x their 2018 total, or that bought nothing at all in 2018.
SELECT ATTRIBUTE(S):
cust, prod, 1_sum_quant, 2_sum_quant
NUMBER OF GROUPING VARIABLES(n):
2
GROUPING ATTRIBUTES(V):
cust, prod
F-VECT([F]):
1_sum_quant, 2_sum_quant, 1_count_quant
SELECT CONDITION-VECT([σ]):
1.cust = cust and 1.prod = prod and 1.year = 2018
2.cust = cust and 2.prod = prod and 2.year = 2019
HAVING_CONDITION(G):
2_sum_quant > 1.2 * 1_sum_quant or not (1_count_quant > 0)
