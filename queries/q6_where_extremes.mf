# WHERE filter plus min/max: 2020 only, per customer and state, smallest and largest
# purchase and the largest purchase made in December.
TABLE: sales
WHERE: year = 2020
SELECT ATTRIBUTE(S):
cust, state, 0_min_quant, 0_max_quant, 1_max_quant
NUMBER OF GROUPING VARIABLES(n):
1
GROUPING ATTRIBUTES(V):
cust, state
F-VECT([F]):
0_min_quant, 0_max_quant, 1_max_quant
SELECT CONDITION-VECT([σ]):
1.cust = cust and 1.state = state and 1.month = 12
