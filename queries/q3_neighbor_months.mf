# EMF: per customer and month, the customer's average quantity in the previous month
# and in the following month (any year). Shifted equality keys still use a hash index.
SELECT ATTRIBUTE(S):
cust, month, 1_avg_quant, 0_avg_quant, 2_avg_quant
NUMBER OF GROUPING VARIABLES(n):
2
GROUPING ATTRIBUTES(V):
cust, month
F-VECT([F]):
1_avg_quant, 0_avg_quant, 2_avg_quant
SELECT CONDITION-VECT([σ]):
1.cust = cust and 1.month = month - 1
2.cust = cust and 2.month = month + 1
