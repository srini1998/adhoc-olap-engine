# EMF with a dependency: per product and month, count sales whose quantity lies
# strictly between the previous and the following month's averages. Grouping
# variable 3 reads aggregates of 1 and 2, so it needs a second scan.
SELECT ATTRIBUTE(S):
prod, month, 3_count_quant
NUMBER OF GROUPING VARIABLES(n):
3
GROUPING ATTRIBUTES(V):
prod, month
F-VECT([F]):
1_avg_quant, 2_avg_quant, 3_count_quant
SELECT CONDITION-VECT([σ]):
1.prod = prod and 1.month = month - 1
2.prod = prod and 2.month = month + 1
3.prod = prod and 3.month = month and 3.quant > 1_avg_quant and 3.quant < 2_avg_quant
